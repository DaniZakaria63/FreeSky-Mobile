# :network keep rules
#
# Nothing here is active today: no module sets isMinifyEnabled, so R8 does not
# shrink release builds yet. These rules must be in place before it is enabled,
# otherwise the Gson-based wire decoding below breaks silently rather than loudly.

# --- Gson reflection -----------------------------------------------------------
# Every API model is a plain Kotlin data class with no @SerializedName annotations
# and is populated by Gson fromJson(). If R8 renames or removes those fields the
# JSON keys stop matching and the models decode to null/defaults with no error,
# so keep the model package and its field names wholesale.
-keep class com.wingsheep.network.model.** { <fields>; }

# apiResponseFrom() builds TypeToken<ApiResponse<T>> subclasses; their generic
# signature must survive shrinking.
-keep class com.google.gson.reflect.TypeToken { *; }
-keep class * extends com.google.gson.reflect.TypeToken
-keepattributes Signature
-keepattributes *Annotation*

# --- Tor (JNI) -----------------------------------------------------------------
# TorService loads libtor.so and the native layer calls back into these types by
# name, which R8 cannot see.
-keep class org.torproject.jni.** { *; }
